Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 100; 100; 100
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Value: true
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Update Topic:
      Value: /map_updates
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Use Timestamp: false
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Value: true
    Alpha: 1
    Color: 255; 80; 60
    Color Transformer: FlatColor
    Position Transformer: XYZ
    Decay Time: 0
    Size (Pixels): 3
    Style: Points
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Filter size: 10
    Use Fixed Frame: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Value: false
    Show Names: false
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.3
    Update Interval: 0.2
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      Angle: 0
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
    Saved: null
Window Geometry:
  Width: 1100
  Height: 760
  X: 80
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: false
